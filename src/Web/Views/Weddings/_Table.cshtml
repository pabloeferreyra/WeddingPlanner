@model IEnumerable<WeddingPlanner.Core.Domain.Entities.Wedding>;

<div class="celebrations-table-heading">
    <div>
        <h2>Celebraciones</h2>
        <p id="weddingsResultCount" role="status" aria-live="polite" aria-atomic="true">Cargando celebraciones...</p>
    </div>
    <button id="weddingSortButton" class="table-sort-button" type="button" aria-label="Ordenar por fecha">
        <span>Ordenar por fecha</span>
        <span aria-hidden="true">↕</span>
    </button>
</div>

<div class="table-responsive celebration-table"
     tabindex="0"
     role="region"
     aria-labelledby="weddingsTableCaption">
    <table id="weddingsTable" class="table align-middle mb-0" aria-busy="true">
        <caption id="weddingsTableCaption" class="visually-hidden">Listado de celebraciones</caption>
        <thead>
            <tr>
                <th scope="col">Evento</th>
                <th scope="col">Estado</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<div class="celebration-pagination">
    <span id="weddingPaginationSummary">1–0 de 0 resultados</span>
    <nav aria-label="Paginación de celebraciones">
        <ul id="weddingPagination" class="pagination mb-0"></ul>
    </nav>
</div>