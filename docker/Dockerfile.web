FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["src/Core/WeddingPlanner.Core.csproj", "src/Core/"]
COPY ["src/Application/WeddingPlanner.Application.csproj", "src/Application/"]
COPY ["src/Infrastructure/WeddingPlanner.Infrastructure.csproj", "src/Infrastructure/"]
COPY ["src/Web/WeddingPlanner.Web.csproj", "src/Web/"]
RUN dotnet restore "src/Web/WeddingPlanner.Web.csproj"

COPY src/ src/
RUN dotnet publish "src/Web/WeddingPlanner.Web.csproj" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080
RUN apt-get update \
	&& apt-get install -y --no-install-recommends libgssapi-krb5-2 \
	&& rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "WeddingPlanner.Web.dll"]