@model WeddingPlanner.Web.Models.VendorDocumentFormViewModel
@using WeddingPlanner.Core.Domain.Entities
@using WeddingPlanner.Core.Domain.Enums
@using WeddingPlanner.Application.Abstractions.Persistence

@{
    var isEdit = Model.Id != Guid.Empty;
    var assignments = (IEnumerable<VendorDocumentAssignment>)ViewData["Assignments"]!;
}

<form asp-controller="VendorDocuments"
      asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-vendorId="@Model.VendorId"
      asp-route-id="@Model.Id"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="VendorId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="DocumentName" class="form-label">Nombre del documento</label>
            <input asp-for="DocumentName" class="form-control" />
            <span asp-validation-for="DocumentName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DocumentType" class="form-label">Tipo</label>
            <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<DocumentType>()" class="form-select"></select>
        </div>
        <div class="col-12">
            <label asp-for="FileUrl" class="form-label">Enlace al archivo</label>
            <input asp-for="FileUrl" type="url" class="form-control" />
            <span asp-validation-for="FileUrl" class="text-danger"></span>
            <div class="form-text">Usa un enlace externo o selecciona un archivo, no ambos.</div>
        </div>
        @if (!isEdit)
        {
            <div class="col-12">
                <label asp-for="File" class="form-label">Archivo</label>
                <input asp-for="File" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png" aria-describedby="file-help" />
                <span asp-validation-for="File" class="text-danger"></span>
                <div id="file-help" class="form-text">Un archivo PDF, JPG o PNG de hasta 10 MiB. Selecciona una contratación de una boda que coordines.</div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Descripción (opcional)</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        }
        <div class="col-md-6">
            <label asp-for="ExpiryDate" class="form-label">Fecha de vencimiento</label>
            <input asp-for="ExpiryDate" type="date" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="VendorAssignmentId" class="form-label">Asignación (opcional)</label>
            <select asp-for="VendorAssignmentId" class="form-select">
                <option value="">Sin asignación</option>
                @foreach (var assignment in assignments)
                {
                    <option value="@assignment.Id">@(assignment.WeddingTitle ?? "Boda no disponible") · @assignment.ContractDate.ToString("d") · @assignment.PaymentAmount.ToString("C")</option>
                }
            </select>
            <span asp-validation-for="VendorAssignmentId" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar documento</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
