@{
    ViewData["Title"] = "Proveedores";
}

<section class="section-heading">
    <div>
        <p class="eyebrow">Tu planificación</p>
        <h1>Proveedores</h1>
    </div>
    <button class="btn btn-primary"
            data-open-modal
            data-modal-id="GlobalModal"
            data-url="/Vendors/Create"
            data-title="Nuevo proveedor"
            type="button">Agregar proveedor</button>
</section>

<div class="d-flex align-items-center mb-2">
    <div class="ms-auto d-flex align-items-center">
        <label for="vendorPageSize" class="me-2 mb-0">Mostrar:</label>
        <select id="vendorPageSize" class="form-select form-select-sm" style="width: auto">
            <option value="25" selected>25 filas</option>
            <option value="50">50 filas</option>
            <option value="100">100 filas</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table id="vendorsTable" class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Proveedor</th>
                <th scope="col">Servicio</th>
                <th scope="col">Ciudad</th>
                <th scope="col">Contacto</th>
                <th scope="col">Calificación</th>
                <th scope="col">Estado</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="7" class="text-center">Cargando proveedores...</td></tr>
        </tbody>
    </table>
</div>
<nav id="vendorPagination" aria-label="Paginación de proveedores"></nav>

@section Scripts {
    <script src="~/js/vendors.js" asp-append-version="true"></script>
}
