@model WeddingPlanner.Web.Models.WeddingFormViewModel

@{
    ViewData["Title"] = "Editar boda";
}

<p class="eyebrow">Actualizar celebración</p>
<h1 class="mb-4">Editar boda</h1>

<form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post" class="card border-0 shadow-sm p-4">
    <partial name="_FormFields" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Details" asp-route-id="@Context.Request.RouteValues["id"]" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
