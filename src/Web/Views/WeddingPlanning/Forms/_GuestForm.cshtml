@model WeddingPlanner.Web.Models.GuestFormViewModel
@using WeddingPlanner.Core.Domain.Enums

@{
    var isEdit = Model.Id != Guid.Empty;
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditGuest" : "CreateGuest")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-id="@Model.Id"
      method="post" class="planning-form" aria-label="Formulario de invitado">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="planning-form-summary text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">Nombre</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Apellido</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PhoneAreaCode" class="form-label">Código de área</label>
            <input asp-for="PhoneAreaCode" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="PhoneNumber" class="form-label">Teléfono</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="RSVPStatus" class="form-label">Confirmación</label>
            <select asp-for="RSVPStatus" asp-items="Html.GetEnumSelectList<GuestStatus>()" class="form-select"></select>
        </div>
        <div class="col-12 form-check">
            <input asp-for="CanBringCompanion" class="form-check-input"
                   data-companion-toggle
                   aria-controls="companion-fields"
                   aria-expanded="@Model.CanBringCompanion.ToString().ToLowerInvariant()" />
            <label asp-for="CanBringCompanion" class="form-check-label">Puede asistir con acompañante</label>
            <span asp-validation-for="CanBringCompanion" class="text-danger d-block"></span>
        </div>
        <fieldset id="companion-fields" class="col-12 p-0 border-0"
                  data-companion-fields hidden="@(!Model.CanBringCompanion)">
            <legend class="form-label">Datos del acompañante</legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanionStatus" class="form-label">Confirmación del acompañante</label>
                    <select asp-for="CompanionStatus"
                            asp-items="Html.GetEnumSelectList<CompanionAttendanceStatus>()"
                            class="form-select"
                            data-companion-status
                            data-pending-value="@((int)CompanionAttendanceStatus.Pending)"></select>
                    <span asp-validation-for="CompanionStatus" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanionName" class="form-label">Nombre del acompañante (opcional)</label>
                    <input asp-for="CompanionName" class="form-control" />
                    <span asp-validation-for="CompanionName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanionMealPreference" class="form-label">Preferencia alimentaria</label>
                    <select asp-for="CompanionMealPreference"
                            asp-items="Html.GetEnumSelectList<MealPreference>()"
                            class="form-select">
                        <option value="">Sin especificar</option>
                    </select>
                    <span asp-validation-for="CompanionMealPreference" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanionDietaryRestrictions" class="form-label">Restricciones alimentarias</label>
                    <input asp-for="CompanionDietaryRestrictions" class="form-control" />
                    <span asp-validation-for="CompanionDietaryRestrictions" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="CompanionNotes" class="form-label">Observaciones del acompañante</label>
                    <textarea asp-for="CompanionNotes" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="CompanionNotes" class="text-danger"></span>
                </div>
            </div>
        </fieldset>
        <div class="col-md-6">
            <label asp-for="MealPreference" class="form-label">Preferencia alimentaria</label>
            <select asp-for="MealPreference" asp-items="Html.GetEnumSelectList<MealPreference>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="TableNumber" class="form-label">Mesa</label>
            <input asp-for="TableNumber" class="form-control" min="1" />
            <span asp-validation-for="TableNumber" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-check align-self-end ms-2">
            <input asp-for="IsFamily" class="form-check-input" />
            <label asp-for="IsFamily" class="form-check-label">Familia</label>
        </div>
        <div class="col-md-3 form-check align-self-end">
            <input asp-for="IsVIP" class="form-check-input" />
            <label asp-for="IsVIP" class="form-check-label">Invitado VIP</label>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notas</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar invitado</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
