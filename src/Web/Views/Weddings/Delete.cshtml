@model WeddingPlanner.Core.Domain.Entities.Wedding

@{
    ViewData["Title"] = "Eliminar boda";
}

<p class="eyebrow">Eliminar celebración</p>
<h1>¿Quieres eliminar esta boda?</h1>
<p class="mb-4">Se eliminará <strong>@Model.Title</strong> y esta acción no se puede deshacer.</p>

<dl class="row">
    <dt class="col-sm-3">Fecha</dt>
    <dd class="col-sm-9">@Model.WeddingDate.ToString("D")</dd>
    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@(Model.Location?.ToString() ?? "Por confirmar")</dd>
</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</form>
