@model WeddingPlanner.Web.Models.VendorFormViewModel

<form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post" id="editVendorForm">
    <partial name="_FormFields" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
