@model WeddingPlanner.Web.Models.GuestFormViewModel
@using WeddingPlanner.Core.Domain.Enums

@{
    var isEdit = Model.Id != Guid.Empty;
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditGuest" : "CreateGuest")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-id="@Model.Id"
      method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">Nombre</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Apellido</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PhoneAreaCode" class="form-label">Código de área</label>
            <input asp-for="PhoneAreaCode" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="PhoneNumber" class="form-label">Teléfono</label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="RSVPStatus" class="form-label">Confirmación</label>
            <select asp-for="RSVPStatus" asp-items="Html.GetEnumSelectList<GuestStatus>()" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="MealPreference" class="form-label">Preferencia alimentaria</label>
            <select asp-for="MealPreference" asp-items="Html.GetEnumSelectList<MealPreference>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="TableNumber" class="form-label">Mesa</label>
            <input asp-for="TableNumber" class="form-control" min="1" />
            <span asp-validation-for="TableNumber" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-check align-self-end ms-2">
            <input asp-for="IsFamily" class="form-check-input" />
            <label asp-for="IsFamily" class="form-check-label">Familia</label>
        </div>
        <div class="col-md-3 form-check align-self-end">
            <input asp-for="IsVIP" class="form-check-input" />
            <label asp-for="IsVIP" class="form-check-label">Invitado VIP</label>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notas</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar invitado</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
