@model WeddingPlanner.Web.Models.WeddingFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="WeddingDate" class="form-label"></label>
        <input asp-for="WeddingDate" type="date" class="form-control" />
        <span asp-validation-for="WeddingDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ExpectedGuestCount" class="form-label"></label>
        <input asp-for="ExpectedGuestCount" class="form-control" min="0" />
        <span asp-validation-for="ExpectedGuestCount" class="text-danger"></span>
    </div>
    <div class="col-12 form-check ms-2">
        <input asp-for="IsWedding" class="form-check-input" data-wedding-type-toggle />
        <label asp-for="IsWedding" class="form-check-label"></label>
    </div>
    <fieldset class="col-12 person-wedding @(Model.IsWedding ? "" : "d-none")" disabled="@(!Model.IsWedding)">
        <legend class="visually-hidden">Datos de la pareja</legend>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="BrideName" class="form-label"></label>
                <input asp-for="BrideName" class="form-control" />
                <span asp-validation-for="BrideName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BrideEmail" class="form-label"></label>
                <input asp-for="BrideEmail" class="form-control" />
                <span asp-validation-for="BrideEmail" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="BridePhone" class="form-label"></label>
                <input asp-for="BridePhone" class="form-control" />
                <span asp-validation-for="BridePhone" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="GroomName" class="form-label"></label>
                <input asp-for="GroomName" class="form-control" />
                <span asp-validation-for="GroomName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="GroomEmail" class="form-label"></label>
                <input asp-for="GroomEmail" class="form-control" />
                <span asp-validation-for="GroomEmail" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="GroomPhone" class="form-label"></label>
                <input asp-for="GroomPhone" class="form-control" />
                <span asp-validation-for="GroomPhone" class="text-danger"></span>
            </div>
        </div>
    </fieldset>
    <fieldset class="col-12 person-celebrated @(Model.IsWedding ? "d-none" : "")" disabled="@Model.IsWedding">
        <legend class="visually-hidden">Datos del festejado o festejada</legend>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="CelebratedName" class="form-label"></label>
                <input asp-for="CelebratedName" class="form-control" />
                <span asp-validation-for="CelebratedName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CelebratedEmail" class="form-label"></label>
                <input asp-for="CelebratedEmail" class="form-control" />
                <span asp-validation-for="CelebratedEmail" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CelebratedPhone" class="form-label"></label>
                <input asp-for="CelebratedPhone" class="form-control" />
                <span asp-validation-for="CelebratedPhone" class="text-danger"></span>
            </div>
        </div>
    </fieldset>
    <div class="col-12">
        <label asp-for="Street" class="form-label"></label>
        <input asp-for="Street" class="form-control" />
        <span asp-validation-for="Street" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="State" class="form-label"></label>
        <input asp-for="State" class="form-control" />
        <span asp-validation-for="State" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ZipCode" class="form-label"></label>
        <input asp-for="ZipCode" class="form-control" />
        <span asp-validation-for="ZipCode" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="InitialBudget" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="InitialBudget" type="number" step="0.01" min="0.01" class="form-control" />
        </div>
        <span asp-validation-for="InitialBudget" class="text-danger"></span>
    </div>
    @if (ViewContext.RouteData.Values["id"] is not null)
    {
        <div class="col-md-6">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="1">En planificación</option>
                <option value="2">Confirmada</option>
                <option value="3">Finalizada</option>
                <option value="4">Cancelada</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    }
</div>