@model WeddingPlanner.Web.Models.VendorPaymentFormViewModel
@using WeddingPlanner.Core.Domain.Enums

@{
    var isEdit = Model.Id != Guid.Empty;
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditVendorPayment" : "CreateVendorPayment")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-assignmentId="@Model.VendorAssignmentId"
      asp-route-id="@Model.Id"
      method="post" class="planning-form" aria-label="Formulario de cuota o pago a proveedor">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <input asp-for="VendorAssignmentId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="planning-form-summary text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Type" class="form-label">Tipo de pago</label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<VendorPaymentType>()" class="form-select"></select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Amount" class="form-label">Importe</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DueDate" class="form-label">Fecha de vencimiento (opcional)</label>
            <input asp-for="DueDate" type="date" class="form-control" aria-describedby="vendor-payment-due-help" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
            <div id="vendor-payment-due-help" class="form-text">Una cuota impaga pasa a vencida después de esta fecha.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="PaymentDate" class="form-label">Fecha de pago (opcional)</label>
            <input asp-for="PaymentDate" type="date" class="form-control" aria-describedby="vendor-payment-date-help" />
            <span asp-validation-for="PaymentDate" class="text-danger"></span>
            <div id="vendor-payment-date-help" class="form-text">Déjala vacía si todavía no se pagó.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="PaymentMethod" class="form-label">Medio de pago (opcional)</label>
            <input asp-for="PaymentMethod" class="form-control" />
            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ReceiptUrl" class="form-label">Enlace al comprobante (opcional)</label>
            <input asp-for="ReceiptUrl" type="url" class="form-control" />
            <span asp-validation-for="ReceiptUrl" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notas (opcional)</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">@(isEdit ? "Guardar cambios" : "Registrar pago")</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
