@model IEnumerable<WeddingPlanner.Core.Domain.Entities.Wedding>;

<div class="d-flex align-items-center mb-2">
    <div class="ms-auto d-flex align-items-center">
        <label class="me-2 mb-0">Mostrar:</label>
        <select id="pageSize" class="form-select form-select-sm" style="width: auto">
            <option value="25">25 filas</option>
            <option value="50">50 filas</option>
            <option value="100" selected>100 filas</option>
            <option value="-1">Todo</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table id="weddingsTable" class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Evento</th>
                <th scope="col">Fecha</th>
                <th scope="col">Lugar</th>
                <th scope="col">Invitados</th>
                <th scope="col">Presupuesto</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<nav>
    <ul id="weddingPagination" class="pagination">
    </ul>
</nav>