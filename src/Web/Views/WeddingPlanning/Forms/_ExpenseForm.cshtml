@model WeddingPlanner.Web.Models.ExpenseFormViewModel
@using WeddingPlanner.Core.Domain.Enums

@{
    var isEdit = Model.Id != Guid.Empty;
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditExpense" : "CreateExpense")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-id="@Model.Id"
      method="post" class="planning-form" aria-label="Formulario de gasto">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <input asp-for="BudgetId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="planning-form-summary text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Description" class="form-label">Descripción</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Category" class="form-label">Categoría</label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<ExpenseCategory>()" class="form-select"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="Amount" class="form-label">Importe</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="VendorName" class="form-label">Proveedor</label>
            <input asp-for="VendorName" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="ExpenseDate" class="form-label">Fecha del gasto</label>
            <input asp-for="ExpenseDate" type="date" class="form-control" />
            <span asp-validation-for="ExpenseDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DueDate" class="form-label">Vencimiento (opcional)</label>
            <input asp-for="DueDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="PaymentDate" class="form-label">Fecha de pago</label>
            <input asp-for="PaymentDate" type="date" class="form-control" />
        </div>
        <div class="col-12 form-check ms-2">
            <input asp-for="IsRecurring" class="form-check-input" data-recurring-toggle />
            <label asp-for="IsRecurring" class="form-check-label">Gasto recurrente</label>
        </div>
        <div class="col-md-6" data-recurring-fields hidden="@(!Model.IsRecurring)">
            <label asp-for="RecurrenceType" class="form-label">Frecuencia</label>
            <select asp-for="RecurrenceType" asp-items="Html.GetEnumSelectList<RecurrenceType>()" class="form-select">
                <option value="">No recurrente</option>
            </select>
        </div>
        <div class="col-md-6">
            <label asp-for="ReceiptUrl" class="form-label">Enlace al comprobante</label>
            <input asp-for="ReceiptUrl" type="url" class="form-control" />
            <span asp-validation-for="ReceiptUrl" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label">Notas</label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar gasto</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
