@model WeddingPlanner.Core.Domain.Entities.Wedding
@using System.Globalization

@{
    ViewData["Title"] = Model.Title ?? "Detalle de la celebración";
    var statusLabel = Model.Status switch
    {
        WeddingPlanner.Core.Domain.Enums.WeddingStatus.Planning => "En planificación",
        WeddingPlanner.Core.Domain.Enums.WeddingStatus.Confirmed => "Confirmada",
        WeddingPlanner.Core.Domain.Enums.WeddingStatus.Completed => "Finalizada",
        WeddingPlanner.Core.Domain.Enums.WeddingStatus.Cancelled => "Cancelada",
        _ => Model.Status.ToString()
    };
    var statusClass = Model.Status.ToString().ToLowerInvariant();
    var eventType = Model.IsWedding ? "Celebración de boda" : "Celebración especial";
    var culture = CultureInfo.GetCultureInfo("es-AR");
}

<div class="wedding-details-page">
    <header class="wedding-details-header">
        <div class="wedding-details-heading">
            <nav class="wedding-details-breadcrumb" aria-label="Ruta de navegación">
                <a asp-controller="Weddings" asp-action="Index">Tus celebraciones</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">Detalle</span>
            </nav>
            <h1>@Model.Title</h1>
            <p>@eventType</p>
        </div>
        <span class="wedding-status-badge wedding-status-@statusClass wedding-details-status">
            @statusLabel
        </span>
        <div class="wedding-details-actions">
            <a class="btn btn-primary"
               asp-controller="WeddingPlanning" asp-action="Index" asp-route-weddingId="@Model.Id">
                Administrar planificación
            </a>
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-open-modal
                    data-modal-id="GlobalModal"
                    data-url="/Weddings/@Model.Id/Edit"
                    data-title="Editar celebración">
                Editar
            </button>
            <a class="btn btn-outline-secondary" asp-controller="Weddings" asp-action="Index">Volver</a>
        </div>
    </header>

    <section class="wedding-details-stats" aria-label="Datos de la celebración">
        <article class="wedding-detail-stat">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                <path d="M7 3v4M17 3v4M3 10h18"></path>
            </svg>
            <span>Fecha del evento</span>
            <strong>@Model.WeddingDate.ToString("dd MMM yyyy", culture)</strong>
        </article>
        <article class="wedding-detail-stat">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="9" cy="8" r="3"></circle>
                <path d="M3.5 19v-1.5a5.5 5.5 0 0 1 11 0V19M16 5.5a3 3 0 0 1 0 5.8M18 14a4.5 4.5 0 0 1 2.5 4v1"></path>
            </svg>
            <span>Invitados esperados</span>
            <strong>@Model.ExpectedGuestCount</strong>
        </article>
        <article class="wedding-detail-stat">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M4 7.5 16 4l4 2v13l-12 2-4-2zM8 6.3v14.3M4 7.5l4 .8 12-2.3"></path>
                <path d="M14 11h3"></path>
            </svg>
            <span>Presupuesto inicial</span>
            <strong>@Model.InitialBudget.ToString("C0", culture)</strong>
        </article>
        <article class="wedding-detail-stat">
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <span>Lugar</span>
            <strong>@(Model.Location?.ToString() ?? "Por confirmar")</strong>
        </article>
    </section>

    <section class="wedding-participants" aria-labelledby="participants-heading">
        <h2 id="participants-heading">Participantes</h2>
        <ul class="wedding-participant-list">
            @if (Model.IsWedding)
            {
                <li class="wedding-participant">
                    <span class="wedding-participant-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"></circle><path d="M6 20v-1a6 6 0 0 1 12 0v1"></path></svg>
                    </span>
                    <span><strong>@(Model.Bride?.Name ?? "Sin informar")</strong><small>Novia</small></span>
                </li>
                <li class="wedding-participant">
                    <span class="wedding-participant-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"></circle><path d="M6 20v-1a6 6 0 0 1 12 0v1"></path></svg>
                    </span>
                    <span><strong>@(Model.Groom?.Name ?? "Sin informar")</strong><small>Novio</small></span>
                </li>
            }
            else
            {
                <li class="wedding-participant">
                    <span class="wedding-participant-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"></circle><path d="M6 20v-1a6 6 0 0 1 12 0v1"></path></svg>
                    </span>
                    <span><strong>@(Model.Celebrated?.Name ?? "Sin informar")</strong><small>Festejado/a</small></span>
                </li>
            }
        </ul>
    </section>

    <section class="wedding-planning-callout">
        <div>
            <h2>
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <rect x="5" y="4" width="14" height="17" rx="2"></rect>
                    <path d="M9 4.5V3h6v1.5M9 10h6M9 14h6M9 18h3"></path>
                </svg>
                Planificación del evento
            </h2>
            <p>Accedé a las tareas, proveedores, invitados y presupuesto de esta celebración.</p>
            <a asp-controller="WeddingPlanning" asp-action="Index" asp-route-weddingId="@Model.Id">
                Ir a la planificación <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</div>
