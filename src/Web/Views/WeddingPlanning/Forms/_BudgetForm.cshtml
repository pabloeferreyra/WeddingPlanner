@model WeddingPlanner.Web.Models.BudgetFormViewModel
@using WeddingPlanner.Core.Domain.Enums

@{
    var isEdit = Model.Id != Guid.Empty;
    var categoryLabels = Html.GetEnumSelectList<ExpenseCategory>()
        .ToDictionary(item => int.Parse(item.Value), item => item.Text);
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditBudget" : "CreateBudget")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-id="@Model.Id"
      method="post" class="planning-form" aria-label="Formulario de presupuesto">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="planning-form-summary text-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label">Presupuesto total</label>
        <input asp-for="TotalAmount" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>
    <fieldset class="mb-3">
        <legend class="form-label">Asignaciones por categoría (opcional)</legend>
        <div class="row g-3">
            @foreach (var category in Enum.GetValues<ExpenseCategory>())
            {
                var key = category.ToString();
                var inputId = $"category-allocation-{key}";
                decimal? amount = Model.CategoryAllocations.TryGetValue(key, out var currentAmount)
                    ? currentAmount
                    : null;
                <div class="col-md-6">
                    <label for="@inputId" class="form-label">@categoryLabels[(int)category]</label>
                    <input id="@inputId" name="CategoryAllocations[@key]" value="@amount"
                           type="number" min="0" step="0.01" class="form-control" />
                </div>
            }
        </div>
        <div class="text-danger">@Html.ValidationMessage("CategoryAllocations")</div>
    </fieldset>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar presupuesto</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
