@model WeddingPlanner.Web.Models.TaskItemFormViewModel
@using WeddingPlanner.Core.Domain.Enums
@using TaskStatus = WeddingPlanner.Core.Domain.Enums.TaskStatus

@{
    var isEdit = Model.Id != Guid.Empty;
}

<form asp-controller="WeddingPlanning"
      asp-action="@(isEdit ? "EditTask" : "CreateTask")"
      asp-route-weddingId="@Model.WeddingId"
      asp-route-id="@Model.Id"
      method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="WeddingId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Title" class="form-label">Tarea</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-md-6">
            <label asp-for="DueDate" class="form-label">Fecha límite</label>
            <input asp-for="DueDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Status" class="form-label">Estado</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label">Prioridad</label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<TaskPriority>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="Category" class="form-label">Categoría</label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<TaskCategory>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="EstimatedHours" class="form-label">Horas estimadas</label>
            <input asp-for="EstimatedHours" type="number" min="1" class="form-control" />
            <span asp-validation-for="EstimatedHours" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ActualHours" class="form-label">Horas reales</label>
            <input asp-for="ActualHours" type="number" min="0" class="form-control" />
            <span asp-validation-for="ActualHours" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Guardar tarea</button>
        <button type="button" class="btn btn-outline-secondary" data-close-modal>Cancelar</button>
    </div>
</form>
