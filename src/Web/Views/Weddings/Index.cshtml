@model IEnumerable<WeddingPlanner.Core.Domain.Entities.Wedding>

@{
    ViewData["Title"] = "Celebraciones";
    string[] methods = ["Index", "Edit", "Create"];
    string modalCreate = string.Format("/Weddings/{0}", methods[2]);
    string modalEdit = string.Format("/Weddings/{0}", methods[1]);
}

<section class="celebrations-header">
    <div class="celebrations-heading">
        <p class="eyebrow">Tu planificación</p>
        <h1>Celebraciones</h1>
        <p class="celebrations-subtitle">Gestiona y organizá todos tus eventos.</p>
    </div>
    <button class="btn btn-primary celebrations-create"
            data-open-modal
            data-modal-id="GlobalModal"
            data-url="@modalCreate"
            data-title="Nueva celebración"
            type="button">
        <span aria-hidden="true">+</span> Crear evento
    </button>
    <div class="celebration-metrics" aria-label="Resumen de celebraciones">
        <div class="celebration-metric">
            <strong id="weddingsTotalMetric">0</strong>
            <span>Eventos totales</span>
        </div>
        <div class="celebration-metric">
            <strong id="weddingsUpcomingMetric">0</strong>
            <span>Próximos</span>
        </div>
        <div class="celebration-metric">
            <strong id="weddingsCompletedMetric">0</strong>
            <span>Finalizados</span>
        </div>
    </div>
</section>

<section class="celebration-filters" aria-label="Filtros de celebraciones">
    <label class="celebration-search">
        <span class="visually-hidden">Buscar celebración</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M16 16l4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <input id="weddingSearch" type="search" class="form-control" placeholder="Buscar celebración..." autocomplete="off" />
    </label>
    <button id="weddingDateFilter" class="filter-button" type="button" aria-haspopup="menu">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
            <rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect>
            <path d="M7 3v4M17 3v4M3 10h18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <span id="weddingDateFilterLabel">Fecha</span>
        <span aria-hidden="true">⌄</span>
    </button>
    <button id="weddingStatusFilter" class="filter-button" type="button" aria-haspopup="menu">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
            <path d="M4 5h16l-6 7v5l-4 2v-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
        <span id="weddingStatusFilterLabel">Estado</span>
        <span aria-hidden="true">⌄</span>
    </button>
</section>

<div class="back container-fluid celebrations-table-shell" id="WeddingsPartial">
    <partial name="_Table" />
</div>
<div class="d-none">@Html.AntiForgeryToken()</div>

@section Scripts {
    <script src="~/js/weddings.js" asp-append-version="true"></script>
}
