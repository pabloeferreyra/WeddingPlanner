@model WeddingPlanner.Web.Models.WeddingPlanningViewModel
@using WeddingPlanner.Core.Domain.Enums
@using TaskStatus = WeddingPlanner.Core.Domain.Enums.TaskStatus

@{
    ViewData["Title"] = $"Organización - {Model.Wedding.Title}";
    var weddingId = Model.Wedding.Id;
    var completedTaskCount = ViewData["CompletedTaskCount"] is int completedTasks ? completedTasks : 0;
    var completedProgressItems = ViewData["CompletedProgressItems"] is int completedItems ? completedItems : 0;
    var totalProgressItems = ViewData["TotalProgressItems"] is int totalItems ? totalItems : 0;
    var progressPercent = ViewData["PlanningProgressPercent"] is int percent ? percent : (int?)null;
    var budgetRemaining = ViewData["BudgetRemaining"] is decimal remaining ? remaining : (decimal?)null;
    var categoryLabels = Html.GetEnumSelectList<ExpenseCategory>()
        .ToDictionary(option => int.Parse(option.Value), option => option.Text);
    var tableNames = Model.Seating.Tables.ToDictionary(table => table.Table.Id, table => table.Table.Name);
}

<div class="planning-page">
    <header class="planning-header" id="planning-overview">
        <div class="planning-header-copy">
            <p class="eyebrow">Espacio de planificación</p>
            <h1>@Model.Wedding.Title</h1>
            <p class="planning-intro">Todo lo necesario para organizar la celebración, en un solo lugar.</p>
            <div class="planning-event-meta">
                <span>Fecha: <time datetime="@Model.Wedding.WeddingDate.ToString("yyyy-MM-dd")">@Model.Wedding.WeddingDate.ToString("D")</time></span>
                <span class="planning-status">@Model.Wedding.Status</span>
            </div>
        </div>
        <a asp-controller="Weddings" asp-action="Details" asp-route-id="@weddingId" class="btn btn-outline-secondary">
            Volver a la celebración
        </a>
    </header>

    @if (TempData["ModuleMessage"] is string message)
    {
        <div class="alert alert-warning" role="alert">@message</div>
    }

    <nav class="planning-nav" aria-label="Secciones de planificación">
        <a href="#planning-summary">Resumen</a>
        <a href="#budget">Presupuesto</a>
        <a href="#guests">Invitados</a>
        <a href="#tables">Mesas</a>
        <a href="#expenses">Gastos</a>
        <a href="#tasks">Tareas</a>
        <a href="#timeline">Cronograma</a>
        <a href="#vendors">Proveedores</a>
    </nav>

    <section class="planning-summary" id="planning-summary" aria-label="Resumen de la planificación">
        <article class="planning-metric planning-progress-card">
            <div class="planning-metric-topline">
                <span class="planning-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" /></svg>
                </span>
                <span class="planning-metric-label">Avance general</span>
            </div>
            @if (progressPercent is int progress)
            {
                <strong class="planning-progress-value">@progress%</strong>
                <progress value="@progress" max="100" aria-label="Progreso general de planificación">@progress%</progress>
                <span class="planning-metric-note">@completedProgressItems de @totalProgressItems actividades completadas</span>
            }
            else
            {
                <strong class="planning-progress-value">Sin actividades</strong>
                <p class="planning-metric-note">Agregá tareas, elementos o actividades para ver el avance.</p>
            }
        </article>
        <article class="planning-metric">
            <div class="planning-metric-topline">
                <span class="planning-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20m5.5-9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-7.5a4 4 0 0 1 0 7.7m4.5 8.8v-1.5a4 4 0 0 0-3-3.87" /></svg>
                </span>
                <span class="planning-metric-label">Asistentes confirmados</span>
            </div>
            <strong class="planning-metric-value">@Model.ConfirmedAttendeeCount</strong>
            <span class="planning-metric-note">
                Invitados principales: @Model.ConfirmedMainGuestCount · Acompañantes: @Model.ConfirmedCompanionCount
            </span>
        </article>
        <article class="planning-metric">
            <div class="planning-metric-topline">
                <span class="planning-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /><path d="M20 12v7H4V5h11" /></svg>
                </span>
                <span class="planning-metric-label">Tareas completadas</span>
            </div>
            <strong class="planning-metric-value">@completedTaskCount <small>/ @Model.Tasks.Count</small></strong>
            <span class="planning-metric-note">tareas finalizadas</span>
        </article>
        <article class="planning-metric">
            <div class="planning-metric-topline">
                <span class="planning-metric-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="2" /><path d="M8 3v4m8-4v4M3 10h18" /></svg>
                </span>
                <span class="planning-metric-label">Presupuesto disponible</span>
            </div>
            @if (budgetRemaining is decimal remainingAmount)
            {
                <strong class="planning-metric-value">@remainingAmount.ToString("C")</strong>
                <span class="planning-metric-note">saldo del presupuesto</span>
            }
            else
            {
                <strong class="planning-metric-value">Sin definir</strong>
                <span class="planning-metric-note">crea un presupuesto para comenzar</span>
            }
        </article>
    </section>

    <section class="planning-module" id="budget" aria-labelledby="budget-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="15" rx="2" /><path d="M3 10h18m-5 5h2" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Finanzas</p>
                    <h2 id="budget-heading">Presupuesto</h2>
                    <p>Tené a mano el total y el dinero disponible para la celebración.</p>
                </div>
            </div>
            @if (Model.Budget is null)
            {
                <button type="button" class="btn btn-primary"
                        data-open-modal data-modal-id="GlobalModal"
                        data-url="@Url.Action("CreateBudget", "WeddingPlanning", new { weddingId })"
                        data-title="Crear presupuesto">Crear presupuesto</button>
            }
            else
            {
                <button type="button" class="btn btn-outline-primary"
                        data-open-modal data-modal-id="GlobalModal"
                        data-url="@Url.Action("EditBudget", "WeddingPlanning", new { weddingId, id = Model.Budget.Id })"
                        data-title="Editar presupuesto">Editar presupuesto</button>
            }
        </div>
        @if (Model.Budget is null)
        {
            <div class="planning-empty-state">Todavía no se definió un presupuesto para esta celebración.</div>
        }
        else
        {
            <dl class="planning-finance-grid">
                <div><dt>Presupuesto total</dt><dd>@Model.Budget.TotalAmount.ToString("C")</dd></div>
                <div><dt>Gastos registrados</dt><dd>@Model.Budget.CurrentSpent.ToString("C")</dd></div>
                <div><dt>Disponible</dt><dd>@budgetRemaining?.ToString("C")</dd></div>
                <div><dt>Consumido</dt><dd>@Model.Budget.GetPercentageSpent().ToString("0.#")%</dd></div>
            </dl>
            <h3>Asignado por categoría vs. gastos registrados</h3>
            @if (Model.BudgetCategorySummaries.Count == 0)
            {
                <p class="planning-empty-state">Todavía no hay asignaciones ni gastos por categoría.</p>
            }
            else
            {
                <div class="planning-table-wrap">
                    <table class="table planning-table">
                        <caption class="visually-hidden">Presupuesto asignado y gastos registrados por categoría</caption>
                        <thead><tr><th scope="col">Categoría</th><th scope="col">Asignado</th><th scope="col">Gastos registrados</th></tr></thead>
                        <tbody>
                        @foreach (var summary in Model.BudgetCategorySummaries)
                        {
                            <tr>
                                <th scope="row" data-label="Categoría">@categoryLabels[(int)summary.Category]</th>
                                <td data-label="Asignado">@summary.AllocatedAmount.ToString("C")</td>
                                <td data-label="Gastos registrados">@summary.ActualSpent.ToString("C")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>

    <section class="planning-module" id="guests" aria-labelledby="guests-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3 20v-1.5A4.5 4.5 0 0 1 7.5 14h3a4.5 4.5 0 0 1 4.5 4.5V20m.5-15a3 3 0 0 1 0 6m2 3h1a3 3 0 0 1 3 3v3" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Lista de asistentes</p>
                    <h2 id="guests-heading">Invitados principales <span class="planning-count">@Model.Guests.Count</span></h2>
                    <p>Organizá confirmaciones, acompañantes, preferencias y mesas.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary"
                    data-open-modal data-modal-id="GlobalModal"
                    data-url="@Url.Action("CreateGuest", "WeddingPlanning", new { weddingId })"
                    data-title="Agregar invitado">Agregar invitado</button>
        </div>
        <div class="planning-table-wrap">
            <table class="table planning-table">
                <caption class="visually-hidden">Invitados de @Model.Wedding.Title</caption>
                <thead><tr><th scope="col">Nombre</th><th scope="col">Correo</th><th scope="col">Confirmación</th><th scope="col">Acompañante</th><th scope="col">Comida</th><th scope="col">Mesa</th><th scope="col">Etiquetas</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.Guests.Count == 0)
                {
                    <tr><td colspan="8"><div class="planning-empty-state">Todavía no hay invitados en la lista.</div></td></tr>
                }
                @foreach (var guest in Model.Guests)
                {
                    var guestStatus = guest.RSVPStatus switch
                    {
                        GuestStatus.Confirmed => "Confirmado",
                        GuestStatus.Declined => "No asiste",
                        _ => "Pendiente"
                    };
                    var effectiveCompanionStatus = guest.RSVPStatus == GuestStatus.Declined
                        ? CompanionAttendanceStatus.Declined
                        : guest.CompanionStatus;
                    var companionStatus = effectiveCompanionStatus switch
                    {
                        CompanionAttendanceStatus.Confirmed => "Asistirá acompañado",
                        CompanionAttendanceStatus.Declined => "No asistirá acompañado",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td data-label="Nombre"><strong>@guest.FirstName @guest.LastName</strong></td>
                        <td data-label="Correo">@(guest.Email ?? "—")</td>
                        <td data-label="Confirmación"><span class="planning-badge planning-badge-@guest.RSVPStatus.ToString().ToLowerInvariant()">@guestStatus</span></td>
                        <td data-label="Acompañante">
                            @if (!guest.CanBringCompanion)
                            {
                                <span class="text-muted">No permitido</span>
                            }
                            else
                            {
                                <span class="planning-badge planning-badge-@effectiveCompanionStatus.ToString().ToLowerInvariant()">@companionStatus</span>
                                @if (!string.IsNullOrWhiteSpace(guest.CompanionName))
                                {
                                    <span class="d-block">@guest.CompanionName</span>
                                }
                                @if (guest.CompanionMealPreference.HasValue)
                                {
                                    <span class="d-block text-muted">Comida: @Html.DisplayFor(_ => guest.CompanionMealPreference)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(guest.CompanionDietaryRestrictions))
                                {
                                    <span class="d-block text-muted">Restricciones: @guest.CompanionDietaryRestrictions</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(guest.CompanionNotes))
                                {
                                    <span class="d-block text-muted">Observaciones: @guest.CompanionNotes</span>
                                }
                            }
                        </td>
                        <td data-label="Comida">@guest.MealPreference</td>
                        <td data-label="Mesa">@(guest.WeddingTableId is Guid tableId ? tableNames.GetValueOrDefault(tableId, "Mesa no disponible") : "—")</td>
                        <td data-label="Etiquetas">
                            @if (guest.IsFamily) { <span class="planning-tag">Familia</span> }
                            @if (guest.IsVIP) { <span class="planning-tag">VIP</span> }
                            @if (!guest.IsFamily && !guest.IsVIP) { <span>—</span> }
                        </td>
                        <td data-label="Acciones" class="planning-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("EditGuest", "WeddingPlanning", new { weddingId, id = guest.Id })"
                                    data-title="Editar invitado">Editar</button>
                            <form asp-controller="WeddingPlanning" asp-action="DeleteGuest"
                                  asp-route-weddingId="@weddingId" asp-route-id="@guest.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="planning-module" id="tables" aria-labelledby="tables-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M3 9h18M5 9v9m14-9v9M4 5h16v4H4z" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Distribución de invitados</p>
                    <h2 id="tables-heading">Mesas <span class="planning-count">@Model.Seating.Tables.Count</span></h2>
                    <p>Organizá las plazas y las asignaciones de cada mesa.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary" data-open-modal data-modal-id="GlobalModal"
                    data-url="@Url.Action("CreateWeddingTable", "WeddingPlanning", new { weddingId })"
                    data-title="Crear mesa">Crear mesa</button>
        </div>
        <div class="planning-seating-summary">
            <span>Mesas: <strong>@Model.Seating.Tables.Count</strong></span>
            <span>Capacidad: <strong>@Model.Seating.TotalCapacity</strong></span>
            <span>Ocupadas: <strong>@Model.Seating.Occupied</strong></span>
            <span>Disponibles: <strong>@Model.Seating.Available</strong></span>
            <span>Invitados sin mesa: <strong>@Model.Seating.UnassignedConfirmedGuests.Count</strong></span>
            <span>Mesas completas: <strong>@Model.Seating.FullTables</strong></span>
        </div>
        <div class="planning-seating-grid">
            @foreach (var summary in Model.Seating.Tables)
            {
                var table = summary.Table;
                var occupancy = summary.Occupancy;
                var status = occupancy.Occupied == 0 ? "Disponible" : occupancy.Available == 0 ? "Completa" : "Parcialmente ocupada";
                <article class="planning-seating-card">
                    <div class="planning-task-heading">
                        <h3>@table.Name</h3>
                        <span class="planning-badge">@status</span>
                    </div>
                    <p>@occupancy.Occupied de @table.Capacity plazas ocupadas · @occupancy.Available disponibles</p>
                    <p>Invitados principales: @occupancy.Attendance.ConfirmedMainGuestCount · Acompañantes: @occupancy.Attendance.ConfirmedCompanionCount</p>
                    <progress value="@occupancy.Occupied" max="@table.Capacity" aria-label="Ocupación de @table.Name">@occupancy.Percentage.ToString("0.#")%</progress>
                    <p>@occupancy.Percentage.ToString("0.#")% de ocupación</p>
                    @if (!string.IsNullOrWhiteSpace(table.Notes))
                    {
                        <p>@table.Notes</p>
                    }
                    <details>
                        <summary>Ver invitados (@summary.Guests.Count)</summary>
                        @if (summary.Guests.Count == 0)
                        {
                            <p>Sin invitados asignados.</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var guest in summary.Guests)
                                {
                                    <li>
                                        @guest.FirstName @guest.LastName
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-open-modal data-modal-id="GlobalModal"
                                                data-url="@Url.Action("EditGuest", "WeddingPlanning", new { weddingId, id = guest.Id })"
                                                data-title="Editar asignación de invitado">Cambiar mesa</button>
                                    </li>
                                }
                            </ul>
                        }
                    </details>
                    <div class="planning-actions">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-open-modal data-modal-id="GlobalModal"
                                data-url="@Url.Action("EditWeddingTable", "WeddingPlanning", new { weddingId, id = table.Id })"
                                data-title="Editar mesa">Editar</button>
                        <form asp-controller="WeddingPlanning" asp-action="DeleteWeddingTable"
                              asp-route-weddingId="@weddingId" asp-route-id="@table.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </div>
                </article>
            }
        </div>
        @if (Model.Seating.Tables.Count == 0)
        {
            <p class="planning-empty-state">Todavía no hay mesas creadas.</p>
        }
        <h3>Invitados confirmados sin mesa</h3>
        @if (Model.Seating.UnassignedConfirmedGuests.Count == 0)
        {
            <p>No hay invitados confirmados sin asignar.</p>
        }
        else
        {
            <ul class="planning-seating-unassigned">
                @foreach (var guest in Model.Seating.UnassignedConfirmedGuests)
                {
                    <li>
                        <span>@guest.FirstName @guest.LastName</span>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-open-modal data-modal-id="GlobalModal"
                                data-url="@Url.Action("EditGuest", "WeddingPlanning", new { weddingId, id = guest.Id })"
                                data-title="Asignar invitado a una mesa">Asignar mesa</button>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="planning-module" id="expenses" aria-labelledby="expenses-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 5h16v15H4zM8 3v4m8-4v4M4 10h16" /><path d="M8 14h3m-3 3h7" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Control financiero</p>
                    <h2 id="expenses-heading">Gastos <span class="planning-count">@Model.Expenses.Count</span></h2>
                    <p>Registrá pagos y comprobantes vinculados al presupuesto.</p>
                </div>
            </div>
            @if (Model.Budget is not null)
            {
                <button type="button" class="btn btn-primary"
                        data-open-modal data-modal-id="GlobalModal"
                        data-url="@Url.Action("CreateExpense", "WeddingPlanning", new { weddingId })"
                        data-title="Agregar gasto">Agregar gasto</button>
            }
        </div>
        <div class="planning-table-wrap">
            <table class="table planning-table">
                <caption class="visually-hidden">Gastos de @Model.Wedding.Title</caption>
                <thead><tr><th scope="col">Descripción</th><th scope="col">Categoría</th><th scope="col">Fecha</th><th scope="col">Vencimiento</th><th scope="col">Proveedor</th><th scope="col">Importe</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.Expenses.Count == 0)
                {
                    <tr><td colspan="8"><div class="planning-empty-state">@(Model.Budget is null ? "Crea un presupuesto para registrar gastos." : "Todavía no hay gastos registrados.")</div></td></tr>
                }
                @foreach (var expense in Model.Expenses)
                {
                    var paymentStatus = expense.GetPaymentStatus(DateOnly.FromDateTime(DateTime.Today));
                    var paymentStatusLabel = paymentStatus switch
                    {
                        ExpensePaymentStatus.Paid => "Pagado",
                        ExpensePaymentStatus.Overdue => "Vencido",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td data-label="Descripción"><strong>@expense.Description</strong></td>
                        <td data-label="Categoría">@categoryLabels[(int)expense.Category]</td>
                        <td data-label="Fecha">@expense.ExpenseDate.ToString("d")</td>
                        <td data-label="Vencimiento">@(expense.DueDate?.ToString("d") ?? "—")</td>
                        <td data-label="Proveedor">@(expense.VendorName ?? "—")</td>
                        <td data-label="Importe"><strong>@expense.Amount.ToString("C")</strong></td>
                        <td data-label="Estado"><span class="planning-badge planning-badge-@paymentStatus.ToString().ToLowerInvariant()">@paymentStatusLabel</span></td>
                        <td data-label="Acciones" class="planning-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("EditExpense", "WeddingPlanning", new { weddingId, id = expense.Id })"
                                    data-title="Editar gasto">Editar</button>
                            <form asp-controller="WeddingPlanning" asp-action="DeleteExpense"
                                  asp-route-weddingId="@weddingId" asp-route-id="@expense.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="planning-module" id="tasks" aria-labelledby="tasks-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /><path d="M20 12v7H4V5h11" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Organización</p>
                    <h2 id="tasks-heading">Tareas y checklist <span class="planning-count">@Model.Tasks.Count</span></h2>
                    <p>Convertí los preparativos en pasos claros y fáciles de seguir.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary"
                    data-open-modal data-modal-id="GlobalModal"
                    data-url="@Url.Action("CreateTask", "WeddingPlanning", new { weddingId })"
                    data-title="Agregar tarea">Agregar tarea</button>
        </div>
        @if (Model.Tasks.Count == 0)
        {
            <div class="planning-empty-state">Todavía no hay tareas. Agregá la primera para empezar a organizarte.</div>
        }
        <div class="planning-task-list">
            @foreach (var task in Model.Tasks)
            {
                var taskStatus = task.Status switch
                {
                    TaskStatus.InProgress => "En curso",
                    TaskStatus.InReview => "En revisión",
                    TaskStatus.Completed => "Completada",
                    TaskStatus.Blocked => "Bloqueada",
                    _ => "Pendiente"
                };
                var taskPriority = task.Priority switch
                {
                    TaskPriority.Low => "Baja",
                    TaskPriority.Medium => "Media",
                    TaskPriority.High => "Alta",
                    TaskPriority.Critical => "Crítica",
                    _ => task.Priority.ToString()
                };
                <article class="planning-task">
                    <div class="planning-task-heading">
                        <div>
                            <p class="eyebrow">@Html.DisplayFor(_ => task.Category)</p>
                            <h3>@task.Title</h3>
                        </div>
                        <span class="planning-badge planning-badge-@task.Status.ToString().ToLowerInvariant()">@taskStatus</span>
                    </div>
                    <div class="planning-task-meta">
                        <span>Vence @task.DueDate.ToString("d")</span>
                        <span>Prioridad: @taskPriority</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(task.Description))
                    {
                        <p class="planning-task-description">@task.Description</p>
                    }
                    <div class="planning-task-actions">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-open-modal data-modal-id="GlobalModal"
                                data-url="@Url.Action("EditTask", "WeddingPlanning", new { weddingId, id = task.Id })"
                                data-title="Editar tarea">Editar tarea</button>
                        <form asp-controller="WeddingPlanning" asp-action="DeleteTask"
                              asp-route-weddingId="@weddingId" asp-route-id="@task.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </div>
                    <div class="planning-checklist-heading">
                        <h4>Checklist <span class="planning-count">@Model.ChecklistItems.Count(item => item.TaskId == task.Id)</span></h4>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-open-modal data-modal-id="GlobalModal"
                                data-url="@Url.Action("CreateChecklistItem", "WeddingPlanning", new { weddingId, taskId = task.Id })"
                                data-title="Agregar al checklist">Agregar elemento</button>
                    </div>
                    <ul class="planning-checklist">
                        @foreach (var item in Model.ChecklistItems.Where(item => item.TaskId == task.Id))
                        {
                            <li>
                                <span class="planning-checklist-label">
                                    <span class="planning-check-indicator @(item.IsCompleted ? "is-complete" : "")" aria-hidden="true">@(item.IsCompleted ? "✓" : "")</span>
                                    <span>@item.Description</span>
                                </span>
                                <span class="planning-actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-open-modal data-modal-id="GlobalModal"
                                            data-url="@Url.Action("EditChecklistItem", "WeddingPlanning", new { weddingId, taskId = task.Id, id = item.Id })"
                                            data-title="Editar elemento">Editar</button>
                                    <form asp-controller="WeddingPlanning" asp-action="DeleteChecklistItem"
                                          asp-route-weddingId="@weddingId" asp-route-taskId="@task.Id" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                    </form>
                                </span>
                            </li>
                        }
                    </ul>
                </article>
            }
        </div>
    </section>

    <section class="planning-module" id="timeline" aria-labelledby="timeline-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Día de la celebración</p>
                    <h2 id="timeline-heading">Cronograma <span class="planning-count">@Model.Timelines.Count</span></h2>
                    <p>Ordená los momentos importantes y sus horarios.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary"
                    data-open-modal data-modal-id="GlobalModal"
                    data-url="@Url.Action("CreateTimeline", "WeddingPlanning", new { weddingId })"
                    data-title="Agregar actividad">Agregar actividad</button>
        </div>
        <div class="planning-table-wrap">
            <table class="table planning-table">
                <caption class="visually-hidden">Cronograma de @Model.Wedding.Title</caption>
                <thead><tr><th scope="col">Actividad</th><th scope="col">Fecha</th><th scope="col">Etapa</th><th scope="col">Lugar</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.Timelines.Count == 0)
                {
                    <tr><td colspan="6"><div class="planning-empty-state">Todavía no hay actividades programadas.</div></td></tr>
                }
                @foreach (var item in Model.Timelines)
                {
                    <tr>
                        <td data-label="Actividad"><strong>@item.EventName</strong></td>
                        <td data-label="Fecha">@item.ScheduledDate.ToString("g")</td>
                        <td data-label="Etapa">@Html.DisplayFor(_ => item.Category)</td>
                        <td data-label="Lugar">@(item.Location ?? "—")</td>
                        <td data-label="Estado"><span class="planning-badge @(item.IsCompleted ? "planning-badge-completed" : "planning-badge-pending")">@(item.IsCompleted ? "Completada" : "Pendiente")</span></td>
                        <td data-label="Acciones" class="planning-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("EditTimeline", "WeddingPlanning", new { weddingId, id = item.Id })"
                                    data-title="Editar actividad">Editar</button>
                            <form asp-controller="WeddingPlanning" asp-action="DeleteTimeline"
                                  asp-route-weddingId="@weddingId" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="planning-module" id="vendors" aria-labelledby="vendors-heading">
        <div class="planning-module-heading">
            <div class="planning-module-title">
                <span class="planning-module-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 9h16l-1 11H5L4 9Zm-1 0 2-5h14l2 5M9 9v3m6-3v3" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Servicios contratados</p>
                    <h2 id="vendors-heading">Proveedores <span class="planning-count">@Model.VendorAssignments.Count</span></h2>
                    <p>Consultá contratos y pagos de cada proveedor.</p>
                </div>
            </div>
            <button type="button" class="btn btn-primary"
                    data-open-modal data-modal-id="GlobalModal"
                    data-url="@Url.Action("CreateVendorAssignment", "WeddingPlanning", new { weddingId })"
                    data-title="Asignar proveedor">Asignar proveedor</button>
        </div>
        <div class="planning-table-wrap">
            <table class="table planning-table">
                <caption class="visually-hidden">Proveedores contratados para @Model.Wedding.Title</caption>
                <thead><tr><th scope="col">Proveedor</th><th scope="col">Contrato</th><th scope="col">Importe</th><th scope="col">Pagado</th><th scope="col">Saldo</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                @if (Model.VendorAssignments.Count == 0)
                {
                    <tr><td colspan="7"><div class="planning-empty-state">Todavía no hay proveedores asignados.</div></td></tr>
                }
                @foreach (var summary in Model.VendorAssignmentPaymentSummaries)
                {
                    var assignment = summary.Assignment;
                    var vendor = Model.Vendors.FirstOrDefault(candidate => candidate.Id == assignment.VendorId);
                    var paymentCount = Model.VendorPayments.Count(payment => payment.VendorAssignmentId == assignment.Id);
                    var paymentStatus = summary.PaymentStatus switch
                    {
                        PaymentStatus.Completed => "Pagado",
                        PaymentStatus.Failed => "Fallido",
                        PaymentStatus.Overdue => "Vencido",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td data-label="Proveedor">
                            <strong>@(vendor?.BusinessName ?? "Proveedor no disponible")</strong>
                            @if (vendor is not null)
                            {
                                <a class="planning-table-link" asp-controller="VendorDocuments" asp-action="Index" asp-route-vendorId="@vendor.Id">Ver documentos</a>
                            }
                        </td>
                        <td data-label="Contrato">@assignment.ContractDate.ToString("d")</td>
                        <td data-label="Importe">@assignment.PaymentAmount.ToString("C")</td>
                        <td data-label="Pagado">@summary.TotalPaid.ToString("C")</td>
                        <td data-label="Saldo"><strong>@summary.RemainingBalance.ToString("C")</strong></td>
                        <td data-label="Estado"><span class="planning-badge planning-badge-@summary.PaymentStatus.ToString().ToLowerInvariant()">@paymentStatus</span></td>
                        <td data-label="Acciones" class="planning-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("CreateVendorPayment", "WeddingPlanning", new { weddingId, assignmentId = assignment.Id })"
                                    data-title="Registrar cuota o pago">Registrar pago</button>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("EditVendorAssignment", "WeddingPlanning", new { weddingId, id = assignment.Id })"
                                    data-title="Editar asignación">Editar</button>
                            <form asp-controller="WeddingPlanning" asp-action="DeleteVendorAssignment"
                                  asp-route-weddingId="@weddingId" asp-route-id="@assignment.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="planning-section" aria-labelledby="vendor-payments-heading">
        <div class="planning-section-heading">
            <div class="planning-section-title">
                <span class="planning-section-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M3 6h18v12H3zM3 10h18m-14 4h4" /></svg>
                </span>
                <div>
                    <p class="eyebrow">Cuotas e historial</p>
                    <h2 id="vendor-payments-heading">Pagos a proveedores <span class="planning-count">@Model.VendorPayments.Count</span></h2>
                    <p>Consulta vencimientos, pagos realizados y comprobantes.</p>
                </div>
            </div>
        </div>
        <div class="planning-table-wrap">
            <table class="table planning-table">
                <caption class="visually-hidden">Cuotas y pagos de proveedores para @Model.Wedding.Title</caption>
                <thead>
                    <tr>
                        <th scope="col">Proveedor</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Vencimiento</th>
                        <th scope="col">Fecha de pago</th>
                        <th scope="col">Importe</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.VendorPayments.Count == 0)
                {
                    <tr><td colspan="7"><div class="planning-empty-state">Todavía no hay cuotas o pagos registrados.</div></td></tr>
                }
                @foreach (var payment in Model.VendorPayments)
                {
                    var assignment = Model.VendorAssignments.FirstOrDefault(candidate => candidate.Id == payment.VendorAssignmentId);
                    var vendor = assignment is null
                        ? null
                        : Model.Vendors.FirstOrDefault(candidate => candidate.Id == assignment.VendorId);
                    var paymentType = payment.Type switch
                    {
                        VendorPaymentType.Deposit => "Anticipo",
                        VendorPaymentType.Final => "Pago final",
                        _ => "Pago parcial"
                    };
                    var paymentStatus = payment.GetStatus(DateOnly.FromDateTime(DateTime.Today));
                    var paymentStatusLabel = paymentStatus switch
                    {
                        VendorPaymentStatus.Paid => "Pagado",
                        VendorPaymentStatus.Overdue => "Vencido",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td data-label="Proveedor"><strong>@(vendor?.BusinessName ?? "Proveedor no disponible")</strong></td>
                        <td data-label="Tipo">@paymentType</td>
                        <td data-label="Vencimiento">@(payment.DueDate?.ToString("d") ?? "—")</td>
                        <td data-label="Fecha de pago">@(payment.PaymentDate?.ToString("d") ?? "—")</td>
                        <td data-label="Importe">@payment.Amount.ToString("C")</td>
                        <td data-label="Estado"><span class="planning-badge planning-badge-@paymentStatus.ToString().ToLowerInvariant()">@paymentStatusLabel</span></td>
                        <td data-label="Acciones" class="planning-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    data-open-modal data-modal-id="GlobalModal"
                                    data-url="@Url.Action("EditVendorPayment", "WeddingPlanning", new { weddingId, assignmentId = payment.VendorAssignmentId, id = payment.Id })"
                                    data-title="Editar cuota o pago">Editar</button>
                            <form asp-controller="WeddingPlanning" asp-action="DeleteVendorPayment"
                                  asp-route-weddingId="@weddingId"
                                  asp-route-assignmentId="@payment.VendorAssignmentId"
                                  asp-route-id="@payment.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/relatedModules.js" asp-append-version="true"></script>
}
