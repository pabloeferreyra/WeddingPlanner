@model WeddingPlanner.Core.Domain.Entities.Wedding

@{
    ViewData["Title"] = Model.Title ?? "Detalle de la boda";
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Detalle de la celebración</p>
        <h1>@Model.Title</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
    </div>
</div>

<dl class="row card border-0 shadow-sm p-4">
    <dt class="col-sm-4">Fecha</dt>
    <dd class="col-sm-8">@Model.WeddingDate.ToString("D")</dd>
    <dt class="col-sm-4">Novia</dt>
    <dd class="col-sm-8">@Model.BrideName</dd>
    <dt class="col-sm-4">Novio</dt>
    <dd class="col-sm-8">@Model.GroomName</dd>
    <dt class="col-sm-4">Lugar</dt>
    <dd class="col-sm-8">@(Model.Location?.ToString() ?? "Por confirmar")</dd>
    <dt class="col-sm-4">Invitados esperados</dt>
    <dd class="col-sm-8">@Model.ExpectedGuestCount</dd>
    <dt class="col-sm-4">Presupuesto inicial</dt>
    <dd class="col-sm-8">@Model.InitialBudget.ToString("C")</dd>
    <dt class="col-sm-4">Estado</dt>
    <dd class="col-sm-8">
        @(Model.Status switch
        {
            WeddingPlanner.Core.Domain.Enums.WeddingStatus.Planning => "En planificación",
            WeddingPlanner.Core.Domain.Enums.WeddingStatus.Confirmed => "Confirmada",
            WeddingPlanner.Core.Domain.Enums.WeddingStatus.Completed => "Finalizada",
            _ => Model.Status.ToString()
        })
    </dd>
</dl>
